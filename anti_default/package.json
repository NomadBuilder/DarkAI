{
  "name": "anti-default",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:darkai": "NODE_ENV=production STATIC_EXPORT=true BASE_PATH=/anti-default next build",
    "start": "next start",
    "lint": "eslint",
    "analyze": "tsx scripts/analyze-code.ts",
