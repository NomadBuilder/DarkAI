{
  "name": "anti-default",
  "version": "0.2.0",
  "private": true,
  "description": "Inclusive language review for websites, docs, and code \u2014 CLI, GitHub Action, and browser extension",
  "homepage": "https://darkai.ca/anti-default",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NomadBuilder/anti-default.git"
  },
  "bugs": {
    "url": "https://github.com/NomadBuilder/anti-default/issues"
  },
  "license": "MIT",
  "bin": {
    "anti-default": "./bin/anti-default.js"
  },
  "files": [
    "bin",
    "scripts/cli.ts",
    "src/cli",
    "src/lib",
    "action.yml",
    ".antidefaultignore.example",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:darkai": "NODE_ENV=production STATIC_EXPORT=true BASE_PATH=/anti-default next build",
    "start": "next start",
    "lint": "eslint",
    "analyze": "node bin/anti-default.js",
    "analyze:urls": "node bin/anti-default.js --urls",
    "cli": "node bin/anti-default.js",
    "corpus": "tsx scripts/check-corpus.ts",
    "extension:rules": "tsx scripts/export-extension-rules.ts",
    "extension:assets": "python3 scripts/generate-extension-assets.py",
    "extension:pack": "bash scripts/pack-extension.sh"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsx": "^4.23.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "keywords": [
    "inclusive-language",
    "linter",
    "accessibility",
    "cli",
    "github-action",
    "sarif"
  ]
}
