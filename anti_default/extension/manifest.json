{
  "manifest_version": 3,
  "name": "Anti-Default — Inclusive Language Highlights",
  "short_name": "Anti-Default",
  "version": "0.1.0",
  "description": "Highlight inclusive-language suggestions on any page. Runs offline from local rules — no AI calls, no tracking.",
  "homepage_url": "https://darkai.ca/anti-default/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Anti-Default",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["rules.json"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
